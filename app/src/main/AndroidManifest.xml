<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- 连线（屏幕识别 · 悬浮窗指导）所需权限：录屏与悬浮窗均为常规系统能力 -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PROJECTION" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- 唯一网络用途：连线页"检查更新"按钮手动查询 GitHub releases 元数据
         （用户主动触发、不自动检查、不内置下载）；识别/引擎/开局库/帮助页全部本地 -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Android 11(API 30)+ 包可见性：设置页用 TextToSpeech.getEngines() 列出设备上
         已安装的 TTS 引擎（第三方引擎需声明此 intent 才对本应用可见）。非权限声明，
         不扩张权限清单/网络面/导出组件。 -->
    <queries>
        <intent>
            <action android:name="android.intent.action.TTS_SERVICE" />
        </intent>
    </queries>

    <application
        android:name=".ChessApp"
        android:allowBackup="false"
        android:icon="@drawable/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@drawable/ic_launcher_round"
        android:supportsRtl="true"
        android:usesCleartextTraffic="false"
        android:theme="@style/Theme.ChineseChess">
        <activity
            android:name=".views.WebviewActivity"
            android:screenOrientation="portrait"
            android:exported="false" />
        <activity
            android:name=".assist.ui.VoiceSettingsActivity"
            android:screenOrientation="portrait"
            android:exported="false" />
        <activity
            android:name=".assist.ui.AssistActivity"
            android:screenOrientation="portrait"
            android:launchMode="singleTask"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <service
            android:name=".assist.ScreenAssistService"
            android:exported="false"
            android:foregroundServiceType="mediaProjection" />
    </application>

</manifest>