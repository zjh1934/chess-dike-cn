<?xml version="1.0" encoding="utf-8"?>
<!--
  增强功能（v1.9 开箱即用）：识别行为永久固定，页面不再有任何档位开关。
  第一屏「怎么用」大字写明：点一下棋盘 → 立刻支招 ＋ 语音播报；不点棋盘完全不动。
  v1.5~v1.8 的四选一互斥 / 两维度档位全部废弃 —— 它们会把点棋盘劫持成「切候选」，
  把识别推理支招播报整条链断掉，用户实测即「点一下没用」。下面其余开关默认已配好。
-->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/xq_paper"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="24dp"
        android:paddingTop="20dp"
        android:paddingBottom="28dp">

        <!-- 页头 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="增强功能"
                android:textColor="@color/xq_ink_text"
                android:textSize="18sp"
                android:textStyle="bold"
                tools:ignore="HardcodedText" />

            <Button
                android:id="@+id/btn_fs_back"
                style="@style/ValueChip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="返回"
                tools:ignore="HardcodedText" />
        </LinearLayout>

        <TextView
            style="@style/StepHint"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:maxLines="6"
            android:ellipsize="none"
            android:text="识别不用设置，装好点一下棋盘就能用。下面这些是额外开关，默认都已配好，不用改。"
            tools:ignore="HardcodedText" />

        <!-- ============ v1.9：怎么用（开箱即用，识别行为固定，没有任何档位开关） ============ -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:text="怎么用"
            android:textColor="@color/xq_zhu"
            android:textSize="13sp"
            android:textStyle="bold"
            tools:ignore="HardcodedText" />

        <TextView
            android:id="@+id/tv_usage_summary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:background="@drawable/engine_chip_bg"
            android:padding="16dp"
            android:lineSpacingExtra="6dp"
            android:text="点一下棋盘 → 立刻支招 ＋ 语音播报\n不点棋盘 → 完全不动\n不用设置，装好就能用"
            android:textColor="@color/xq_ink_text"
            android:textSize="17sp"
            android:textStyle="bold"
            tools:ignore="HardcodedText" />

        <TextView
            style="@style/StepHint"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:maxLines="6"
            android:ellipsize="none"
            android:text="识别不用选档位，点一下就出招、并念出纯中文着法；没认清棋盘会提示「再点一次」。下面这些默认都已配好，不用改。"
            tools:ignore="HardcodedText" />

        <!-- ============ 3. 中文播报 ============ -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:text="中文播报"
            android:textColor="@color/xq_zhu"
            android:textSize="13sp"
            android:textStyle="bold"
            tools:ignore="HardcodedText" />

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="10dp" android:gravity="center_vertical" android:orientation="horizontal">
            <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                android:text="支招播报（总开关）" android:textColor="@color/xq_ink_text" android:textSize="13sp"
                tools:ignore="HardcodedText" />
            <Button android:id="@+id/btn_voice_enabled" style="@style/ValueChip"
                android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="开"
                tools:ignore="HardcodedText" />
        </LinearLayout>

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="8dp" android:gravity="center_vertical" android:orientation="horizontal">
            <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                android:text="播报引擎" android:textColor="@color/xq_ink_text" android:textSize="13sp"
                tools:ignore="HardcodedText" />
            <Button android:id="@+id/btn_voice_engine" style="@style/ValueChip"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:maxWidth="180dp" android:ellipsize="end" android:text="跟随系统"
                tools:ignore="HardcodedText" />
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="播报内容（勾选哪些读哪些）"
            android:textColor="@color/xq_zhu"
            android:textSize="13sp"
            android:textStyle="bold"
            tools:ignore="HardcodedText" />

        <TextView
            style="@style/StepHint"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="只读纯中文着法（去掉界面坐标）；默认只播报支招建议与开局库着法"
            tools:ignore="HardcodedText" />

        <CheckBox android:id="@+id/cb_read_suggestion" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:layout_marginTop="8dp" android:minHeight="40dp"
            android:text="支招建议（含备选变招）" android:textColor="@color/xq_ink_text" android:textSize="13sp"
            tools:ignore="HardcodedText" />
        <CheckBox android:id="@+id/cb_read_book" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:minHeight="40dp"
            android:text="开局库着法" android:textColor="@color/xq_ink_text" android:textSize="13sp"
            tools:ignore="HardcodedText" />
        <CheckBox android:id="@+id/cb_read_opponent_plan" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:minHeight="40dp"
            android:text="对方回合预案" android:textColor="@color/xq_ink_text" android:textSize="13sp"
            tools:ignore="HardcodedText" />
        <CheckBox android:id="@+id/cb_read_evaluation" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:minHeight="40dp"
            android:text="态势评估（胜率/优劣势/深度）" android:textColor="@color/xq_ink_text" android:textSize="13sp"
            tools:ignore="HardcodedText" />
        <CheckBox android:id="@+id/cb_read_status" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:minHeight="40dp"
            android:text="状态与异常提示" android:textColor="@color/xq_ink_text" android:textSize="13sp"
            tools:ignore="HardcodedText" />

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="10dp" android:gravity="center_vertical" android:orientation="horizontal">
            <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                android:text="播报试听" android:textColor="@color/xq_ink_text" android:textSize="13sp"
                tools:ignore="HardcodedText" />
            <Button android:id="@+id/btn_voice_test" style="@style/ValueChip"
                android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="试听"
                tools:ignore="HardcodedText" />
        </LinearLayout>

        <!-- ============ 4. 诊断与工具 ============ -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:text="诊断与工具"
            android:textColor="@color/xq_zhu"
            android:textSize="13sp"
            android:textStyle="bold"
            tools:ignore="HardcodedText" />

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="10dp" android:gravity="center_vertical" android:orientation="horizontal">
            <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                android:text="增强功能诊断记录" android:textColor="@color/xq_ink_text" android:textSize="13sp"
                tools:ignore="HardcodedText" />
            <Button android:id="@+id/btn_voice_diag" style="@style/ValueChip"
                android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="开"
                tools:ignore="HardcodedText" />
        </LinearLayout>

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="8dp" android:gravity="center_vertical" android:orientation="horizontal">
            <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                android:text="导出增强功能诊断（MD）" android:textColor="@color/xq_ink_text" android:textSize="13sp"
                tools:ignore="HardcodedText" />
            <Button android:id="@+id/btn_voice_export" style="@style/ValueChip"
                android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="导出"
                tools:ignore="HardcodedText" />
        </LinearLayout>

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="8dp" android:gravity="center_vertical" android:orientation="horizontal">
            <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                android:text="清空增强功能诊断日志" android:textColor="@color/xq_ink_text" android:textSize="13sp"
                tools:ignore="HardcodedText" />
            <Button android:id="@+id/btn_voice_clear" style="@style/ValueChip"
                android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="清空"
                tools:ignore="HardcodedText" />
        </LinearLayout>

        <!-- ============ 5. 构建期固定（只读） ============ -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:text="构建期固定（只读·运行时不可关闭）"
            android:textColor="@color/xq_zhu"
            android:textSize="13sp"
            android:textStyle="bold"
            tools:ignore="HardcodedText" />

        <TextView
            style="@style/StepHint"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:maxLines="8"
            android:ellipsize="none"
            android:text="包名锁定：com.xqdk.chess（CI 有 aapt 门禁）。固定签名：出包用仓库 Secret 里的固定钥匙，各版本可直接覆盖安装。这两项是出包时锁死的，App 内不提供开关，改了会导致无法覆盖升级。"
            tools:ignore="HardcodedText" />

        <TextView
            style="@style/StepHint"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:maxLines="8"
            android:ellipsize="none"
            android:text="识别引擎 / 思考制式 / 局面预判 / 性能诊断 / 悬浮窗主题属上游原有功能，开关仍在连线主页，未收进本页。"
            tools:ignore="HardcodedText" />

    </LinearLayout>
</ScrollView>
