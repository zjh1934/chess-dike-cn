<?xml version="1.0" encoding="utf-8"?>
<!-- 语音设置页（v1.2）：把 v1.1 主页 5 个语音入口全部收进独立页面，
     并新增「朗读内容多选」5 个勾选框。结构与连线页设置行同构（TextView + ValueChip）。 -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/xq_paper"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="24dp"
        android:paddingTop="20dp"
        android:paddingBottom="28dp">

        <!-- 页头：标题 + 返回 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="语音设置"
                android:textColor="@color/xq_ink_text"
                android:textSize="18sp"
                android:textStyle="bold"
                tools:ignore="HardcodedText" />

            <Button
                android:id="@+id/btn_voice_back"
                style="@style/ValueChip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="返回"
                tools:ignore="HardcodedText" />
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:text="基础"
            android:textColor="@color/xq_zhu"
            android:textSize="13sp"
            android:textStyle="bold"
            tools:ignore="HardcodedText" />

        <!-- 1. 语音提示总开关 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="语音提示"
                android:textColor="@color/xq_ink_text"
                android:textSize="13sp"
                tools:ignore="HardcodedText" />

            <Button
                android:id="@+id/btn_voice_enabled"
                style="@style/ValueChip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="开"
                tools:ignore="HardcodedText" />
        </LinearLayout>

        <!-- 2. 语音提示引擎 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="语音提示引擎"
                android:textColor="@color/xq_ink_text"
                android:textSize="13sp"
                tools:ignore="HardcodedText" />

            <Button
                android:id="@+id/btn_voice_engine"
                style="@style/ValueChip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxWidth="180dp"
                android:ellipsize="end"
                android:text="跟随系统"
                tools:ignore="HardcodedText" />
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:text="朗读内容（勾选哪些读哪些）"
            android:textColor="@color/xq_zhu"
            android:textSize="13sp"
            android:textStyle="bold"
            tools:ignore="HardcodedText" />

        <TextView
            style="@style/StepHint"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="默认只朗读支招建议与开局库着法"
            tools:ignore="HardcodedText" />

        <!-- 3. 五个朗读内容勾选项（CheckBox 读写 voiceReadMask 位掩码） -->
        <CheckBox
            android:id="@+id/cb_read_suggestion"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:minHeight="40dp"
            android:text="支招建议（含备选变招）"
            android:textColor="@color/xq_ink_text"
            android:textSize="13sp"
            tools:ignore="HardcodedText" />

        <CheckBox
            android:id="@+id/cb_read_book"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="40dp"
            android:text="开局库着法"
            android:textColor="@color/xq_ink_text"
            android:textSize="13sp"
            tools:ignore="HardcodedText" />

        <CheckBox
            android:id="@+id/cb_read_opponent_plan"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="40dp"
            android:text="对方回合预案"
            android:textColor="@color/xq_ink_text"
            android:textSize="13sp"
            tools:ignore="HardcodedText" />

        <CheckBox
            android:id="@+id/cb_read_evaluation"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="40dp"
            android:text="态势评估（胜率/优劣势/深度）"
            android:textColor="@color/xq_ink_text"
            android:textSize="13sp"
            tools:ignore="HardcodedText" />

        <CheckBox
            android:id="@+id/cb_read_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="40dp"
            android:text="状态与异常提示"
            android:textColor="@color/xq_ink_text"
            android:textSize="13sp"
            tools:ignore="HardcodedText" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:text="诊断与工具"
            android:textColor="@color/xq_zhu"
            android:textSize="13sp"
            android:textStyle="bold"
            tools:ignore="HardcodedText" />

        <!-- 4. 试听 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="语音试听"
                android:textColor="@color/xq_ink_text"
                android:textSize="13sp"
                tools:ignore="HardcodedText" />

            <Button
                android:id="@+id/btn_voice_test"
                style="@style/ValueChip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="试听"
                tools:ignore="HardcodedText" />
        </LinearLayout>

        <!-- 5. 诊断记录开关 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="诊断记录"
                android:textColor="@color/xq_ink_text"
                android:textSize="13sp"
                tools:ignore="HardcodedText" />

            <Button
                android:id="@+id/btn_voice_diag"
                style="@style/ValueChip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="开"
                tools:ignore="HardcodedText" />
        </LinearLayout>

        <!-- 6. 导出诊断日志（SAF 自选路径） -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="导出诊断日志"
                android:textColor="@color/xq_ink_text"
                android:textSize="13sp"
                tools:ignore="HardcodedText" />

            <Button
                android:id="@+id/btn_voice_export"
                style="@style/ValueChip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="导出"
                tools:ignore="HardcodedText" />
        </LinearLayout>

        <!-- 7. 清空日志 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="清空日志"
                android:textColor="@color/xq_ink_text"
                android:textSize="13sp"
                tools:ignore="HardcodedText" />

            <Button
                android:id="@+id/btn_voice_clear"
                style="@style/ValueChip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="清空"
                tools:ignore="HardcodedText" />
        </LinearLayout>

        <!-- 悬浮窗快捷操作（v1.3）：与语音无关，按用户要求放在本设置页 -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:text="悬浮窗快捷操作"
            android:textColor="@color/xq_zhu"
            android:textSize="13sp"
            android:textStyle="bold"
            tools:ignore="HardcodedText" />

        <!-- 8. 快捷刷新开关（默认关，文字与默认值一致） -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="快捷刷新"
                android:textColor="@color/xq_ink_text"
                android:textSize="13sp"
                tools:ignore="HardcodedText" />

            <Button
                android:id="@+id/btn_quick_refresh"
                style="@style/ValueChip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="关"
                tools:ignore="HardcodedText" />
        </LinearLayout>

        <!-- StepHint 样式默认 maxLines=1 + ellipsize=end，长说明在此显式放开，
             否则「翻转走子方 / 手动模式不受影响」等关键提示会被截成一行看不到 -->
        <TextView
            style="@style/StepHint"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:maxLines="10"
            android:ellipsize="none"
            android:text="开启后，点悬浮窗迷你棋盘 = 点右列「更新」按钮：翻转走子方、重建棋局并重新分析（悬浮窗提示「棋局已更新」）。关闭时点棋盘仍是切换候选着法。手动摆棋模式下点棋盘始终用于选子/走子，不受影响。"
            tools:ignore="HardcodedText" />

    </LinearLayout>
</ScrollView>
